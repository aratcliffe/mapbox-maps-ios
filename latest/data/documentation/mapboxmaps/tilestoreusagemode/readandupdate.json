{"kind":"symbol","metadata":{"role":"symbol","symbolKind":"case","modules":[{"name":"MapboxMaps"}],"externalID":"c:@E@MBMTileStoreUsageMode@MBMTileStoreUsageModeReadAndUpdate","roleHeading":"Case","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"readAndUpdate","kind":"identifier"}],"title":"TileStoreUsageMode.readAndUpdate","navigatorTitle":[{"kind":"identifier","text":"MBMTileStoreUsageModeReadAndUpdate"}]},"hierarchy":{"paths":[["doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps","doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate"]}],"abstract":[{"type":"text","text":"Tile store enabled for accessing local tile packs and for loading new tile packs from server."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode\/readAndUpdate"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"readAndUpdate"}]}]},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"All tile requests are converted to tile pack requests, i.e."},{"type":"text","text":" "},{"text":"the tile pack that includes the request tile will be loaded, and the tile extracted","type":"text"},{"type":"text","text":" "},{"type":"text","text":"from it. In this mode, no individual tile requests will be made."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This mode can be useful if the map trajectory is predefined and the user cannot pan"},{"type":"text","text":" "},{"type":"text","text":"freely (e.g. navigation use cases), so that there is a good chance tile packs are already loaded"},{"text":" ","type":"text"},{"type":"text","text":"in the vicinity of the user."}]},{"type":"paragraph","inlineContent":[{"text":"If users can pan freely, this mode is not recommended. Otherwise, panning","type":"text"},{"text":" ","type":"text"},{"text":"will download tile packs instead of using individual tiles. Note that this means that we could first","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"download an individual tile, and then a tile pack that also includes this tile. The individual tile in"},{"type":"text","text":" "},{"text":"the disk cache won’t be used as long as the up-to-date tile pack exists in the cache.","type":"text"}]}],"kind":"content"}],"sections":[],"references":{"doc://com.mapbox.MapboxMaps/documentation/MapboxMaps/TileStoreUsageMode/readAndUpdate":{"kind":"symbol","title":"TileStoreUsageMode.readAndUpdate","url":"\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate","abstract":[{"text":"Tile store enabled for accessing local tile packs and for loading new tile packs from server.","type":"text"}],"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readAndUpdate","kind":"identifier"}],"identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode\/readAndUpdate","type":"topic","navigatorTitle":[{"text":"MBMTileStoreUsageModeReadAndUpdate","kind":"identifier"}]},"doc://com.mapbox.MapboxMaps/documentation/MapboxMaps":{"type":"topic","role":"collection","title":"MapboxMaps","kind":"symbol","url":"\/documentation\/mapboxmaps","abstract":[{"text":"Interactive, thoroughly customizable maps for iOS powered by vector tiles and Metal.","type":"text"}],"identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps"},"doc://com.mapbox.MapboxMaps/documentation/MapboxMaps/TileStoreUsageMo