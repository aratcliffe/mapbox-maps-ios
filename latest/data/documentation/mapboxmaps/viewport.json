rt","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"Currently, several types of viewport are supported:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Default Style viewport sets the camera to the camera parameters defined in the Style root property. This type is used by default.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Camera viewport allows to directly set camera using center coordinate, zoom, bearing, pitch, and anchor."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Overview viewport helps to focus the map camera on a specified Geometry with the minimum zoom level. For example, focus user attention on a route line."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Follow Puck viewport automatically tracks the user’s position on the map."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Idle viewport is activated when the user interacts with the map. You can also set it to interrupt the ongoing viewport transition animation.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Typically, you set viewport via two methods: by setting the constant initial viewport, or passing the viewport "},{"code":"Binding","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The former method is handy to set viewport only once, at map initialization time:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct StaticViewport: View {","    var body: some View {","        \/\/ Focus camera on Disneyland at zoom 10.","        Map(initialViewport: .camera(center: disneyland, zoom: 10))","    }","}","","private let disneyland = CLLocationCoordinate(latitude: 33.812092,